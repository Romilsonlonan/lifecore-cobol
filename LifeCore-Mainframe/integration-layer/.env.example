# ================================================================
# .env.example — Integration Layer do LifeCore-Mainframe
# Copie para .env e ajuste para o seu ambiente.
# NUNCA commite o .env com credenciais reais.
# ================================================================

# ── Caminhos dos datasets ────────────────────────────────────────
DATA_INPUT_DIR=/tmp/lifecore/DATA/INPUT
DATA_OUTPUT_DIR=/tmp/lifecore/DATA/OUTPUT
DATA_QUARANTINE_DIR=/tmp/lifecore/DATA/QUARANTINE
LOAD_DIR=/tmp/lifecore/LOAD

# ── Banco de dados ───────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:lifecore@localhost:5432/lifecore

# ── DB2 z/OS: fonte única dos cadastros compartilhados com CICS ──
# Configure uma string DRDA sem gravar credenciais no repositório.
DB2_DSN=
DB2_SCHEMA=LIFECORE

# ── Conector batch ───────────────────────────────────────────────
# Opções: stub | local | zowe
BATCH_CONNECTOR=stub

# ── Zowe (somente se BATCH_CONNECTOR=zowe) ──────────────────────
ZOWE_PROFILE=zos-dev
ZOS_HLQ=LIFECORE
ZOS_DB2_SYSTEM=DB2P

# ── Autenticação JWT ─────────────────────────────────────────────
# ATENÇÃO: Gere uma chave segura em produção:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=troque-esta-chave-em-producao-use-secrets-token-hex-32
AUTH_ACCESS_EXPIRE_MIN=30
AUTH_REFRESH_EXPIRE_H=168
AUTH_MAX_LOGIN_ATTEMPTS=5

# Usuário admin padrão (seed):
#   E-mail : admin@lifecore.com.br
#   Senha  : lifecore@2026   ← TROQUE IMEDIATAMENTE em produção

# ── OpenTelemetry ────────────────────────────────────────────────
# OTEL_ENABLED=false  → desabilitado (padrão dev)
# OTEL_ENABLED=true   → ativa tracing
OTEL_ENABLED=false
OTEL_SERVICE_NAME=lifecore-integration-layer
ENVIRONMENT=development

# Exporter: console | grpc | http
OTEL_EXPORTER_TYPE=console

# Endpoint gRPC do Collector (Jaeger / Grafana Agent / DataDog)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Endpoint HTTP do Collector
OTEL_EXPORTER_OTLP_HTTP_ENDPOINT=http://localhost:4318/v1/traces

# ── Object Storage — S3-compatible (Supabase Storage) ───────────
# O Supabase Storage expõe o protocolo S3 nativo.
# Para configurar:
#   1. Supabase Dashboard → Storage → S3 Connection → ative o toggle
#   2. Anote o Endpoint e a Region mostrados na tela
#   3. Clique em "+ New access key" e copie KEY ID + SECRET (aparece só uma vez)
#
# Endpoint:  https://<projeto>.storage.supabase.co/storage/v1/s3
# Region:    sa-east-1  (ou conforme mostrado no painel)
STORAGE_ENDPOINT=https://SEU-PROJETO.storage.supabase.co/storage/v1/s3
STORAGE_ACCESS_KEY=cole-o-key-id-gerado-no-painel
STORAGE_SECRET_KEY=cole-o-secret-gerado-no-painel
STORAGE_REGION=sa-east-1
STORAGE_BUCKET=ecm-docs

# ── Supabase (tabelas relacionais) ───────────────────────────────
# Usado para: estipulantes, ecm_docs (metadados), apolice_seq.
# O storage de arquivos usa o endpoint S3 acima (mesma conta Supabase).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── Frontend Next.js ─────────────────────────────────────────────
# Caminho absoluto para o build estático gerado por 'npm run build'
# em frontend/. Deixe em branco para usar o padrão: <repo>/frontend/out
# FRONTEND_BUILD_DIR=/caminho/para/frontend/out
