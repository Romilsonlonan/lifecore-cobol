//LCESBLC1 JOB (LCIQ),'LIFECORE CICS DB2 EMPRESA',CLASS=A,
//            MSGCLASS=X,MSGLEVEL=(1,1),NOTIFY=&SYSUID
//*--------------------------------------------------------------------*
//* Traduz CICS, precompila SQL DB2 e compila o cadastro LCCICS04.
//* Antes de habilitar no CICS, vincule o DBRM ao package/plan usado
//* pela conexao DB2 da regiao CICS (DB2CONN/DB2ENTRY).
//* Ajuste nomes de bibliotecas e versoes para o ambiente de destino.
//*--------------------------------------------------------------------*
//TRN04    EXEC PGM=DFHPC,
//            PARM='XOPTS(COBOL2 NOEPILOG NOPROLOG SP)'
//STEPLIB  DD DSN=CICSTS.V5R6M0.CICS.SDFHLOAD,DISP=SHR
//SYSIN    DD DSN=HERC01.LIFECORE.CICS(LCCICS04),DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DSN=&&CICS04,DISP=(,PASS),
//            UNIT=SYSDA,SPACE=(CYL,(1,1))
//*
//DB2P04   EXEC PGM=DSNHPC,COND=(0,NE,TRN04),
//            PARM='HOST(IBMCOB),CICS,APOST'
//STEPLIB  DD DSN=DSN.V13.SDSNLOAD,DISP=SHR
//SYSIN    DD DSN=&&CICS04,DISP=(OLD,DELETE)
//SYSCIN   DD DSN=&&DB2COB04,DISP=(,PASS),
//            UNIT=SYSDA,SPACE=(CYL,(1,1))
//DBRMLIB  DD DSN=HERC01.LIFECORE.DBRMLIB(LCCICS04),DISP=SHR
//SYSLIB   DD DSN=HERC01.LIFECORE.COPYLIB,DISP=SHR
//         DD DSN=DSN.V13.SDSNMACS,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//*
//COB04    EXEC PGM=IGYCRCTL,COND=(0,NE,DB2P04),
//            PARM='RENT,NODYNAM,TRUNC(OPT),OBJECT,NOLIST'
//SYSLIB   DD DSN=HERC01.LIFECORE.COPYLIB,DISP=SHR
//         DD DSN=CICSTS.V5R6M0.CICS.SDFHCOB,DISP=SHR
//SYSIN    DD DSN=&&DB2COB04,DISP=(OLD,DELETE)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT2   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT3   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT4   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT5   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT6   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT7   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSLIN   DD DSN=&&LCCOB04,DISP=(,PASS),
//            UNIT=SYSDA,SPACE=(CYL,(1,1))
//*
//LNK04    EXEC PGM=IEWL,COND=(0,NE,COB04),
//            PARM='REUS,LIST,MAP'
//SYSLIB   DD DSN=CICSTS.V5R6M0.CICS.SDFHLOAD,DISP=SHR
//         DD DSN=SYS1.LINKLIB,DISP=SHR
//SYSLMOD  DD DSN=HERC01.LIFECORE.CICS.LOAD(LCCICS04),DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DSN=&&LCCOB04,DISP=(OLD,DELETE)
//         DD *
  INCLUDE SYSLIB(DFHECI)
/*
