* --- TRANSACOES -----------------------------------------------------
*
 DEFINE TRANSACTION(LCIN)
        GROUP(LIFECORE)
        DESCRIPTION(LifeCore IQ - Login)
        PROGRAM(LCCICS01)
        TWASIZE(0)
        PROFILE(DFHCICST)
        STATUS(ENABLED)
        TASKDATALOC(ANY)
        TASKDATAKEY(USER)
        STORAGECLEAR(NO)
        RUNAWAY(SYSTEM)
        SHUTDOWN(ENABLED)
        ISOLATE(YES)
        BREXIT(DFHDBORG)
