*
* --- ARQUIVOS VSAM --------------------------------------------------
*
 DEFINE FILE(LCAPOLVC)
        GROUP(LIFECORE)
        DESCRIPTION(LifeCore IQ - VSAM KSDS Apolices)
        DSNAME(LIFECORE.VSAM.APOLICE)
        DISPOSITION(SHARE)
        DSNSHARING(ALLREQS)
        STRINGS(3)
        LSRPOOLID(1)
        READINTEG(UNCOMMITTED)
        DATABUFFERS(2)
        INDEXBUFFERS(1)
        TYPE(VSAM)
        RLSACCESS(NO)
        REMOTESYSTEM()
        REMOTENAME()
        KEYLENGTH(10)
        RECORDSIZE(200)
        ADD(NO)
        BROWSE(YES)
        DELETE(NO)
        READ(YES)
        UPDATE(NO)
        STATUS(ENABLED)
        OPENTIME(FIRSTREF)
        TABLE(NO)
        MAXNUMRECS(NOLIMIT)
        LOAD(NO)
        UPDATEMODEL(LOCKING)
        BLOCKKEYLEN(0)
        BLOCKSIZE(0)
*
 DEFINE FILE(LCCOBTVC)
        GROUP(LIFECORE)
        DESCRIPTION(LifeCore IQ - VSAM KSDS Coberturas/Segurados)
        DSNAME(LIFECORE.VSAM.COBERTURA)
        DISPOSITION(SHARE)
        DSNSHARING(ALLREQS)
        STRINGS(3)
        LSRPOOLID(1)
        READINTEG(UNCOMMITTED)
        DATABUFFERS(2)
        INDEXBUFFERS(1)
        TYPE(VSAM)
        RLSACCESS(NO)
        KEYLENGTH(21)
        RECORDSIZE(150)
        ADD(NO)
        BROWSE(YES)
        DELETE(NO)
        READ(YES)
        UPDATE(NO)
        STATUS(ENABLED)
        OPENTIME(FIRSTREF)
        TABLE(NO)
        MAXNUMRECS(NOLIMIT)
        LOAD(NO)
        UPDATEMODEL(LOCKING)
*
*--------------------------------------------------------------------*
 INSTALL GROUP(LIFECORE)
*--------------------------------------------------------------------*
