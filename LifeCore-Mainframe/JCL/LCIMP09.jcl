//LCIMP09 JOB (LCIQ),'LIFECORE CICS IMPORT QUERY',CLASS=A,
//            MSGCLASS=X,MSGLEVEL=(1,1),NOTIFY=&SYSUID
//*--------------------------------------------------------------------*
//* Compila LCCICS09 com traducao CICS, precompilacao DB2 e link-edit.
//* Requer mapset LCMAPA09/LCMSET9 gerado pelo LCBMSC01.
//* Vincule o DBRM LCCICS09 ao package/plan da regiao CICS antes do uso.
//* Ajuste nomes de bibliotecas e versoes para o ambiente de destino.
//*--------------------------------------------------------------------*
//TRN09    EXEC PGM=DFHPC,
//            PARM='XOPTS(COBOL2 NOEPILOG NOPROLOG SP)'
//STEPLIB  DD DSN=CICSTS.V5R6M0.CICS.SDFHLOAD,DISP=SHR
//SYSIN    DD DSN=HERC01.LIFECORE.CICS(LCCICS09),DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DSN=&&CICS09,DISP=(,PASS),
//            UNIT=SYSDA,SPACE=(CYL,(1,1))
//*
//DB2P09   EXEC PGM=DSNHPC,COND=(0,NE,TRN09),
//            PARM='HOST(IBMCOB),CICS,APOST'
//STEPLIB  DD DSN=DSN.V13.SDSNLOAD,DISP=SHR
//SYSIN    DD DSN=&&CICS09,DISP=(OLD,DELETE)
//SYSCIN   DD DSN=&&DB2COB09,DISP=(,PASS),
//            UNIT=SYSDA,SPACE=(CYL,(1,1))
//DBRMLIB  DD DSN=HERC01.LIFECORE.DBRMLIB(LCCICS09),DISP=SHR
//SYSLIB   DD DSN=HERC01.LIFECORE.COPYLIB,DISP=SHR
//         DD DSN=DSN.V13.SDSNMACS,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//*
//COB09    EXEC PGM=IGYCRCTL,COND=(0,NE,DB2P09),
//            PARM='RENT,NODYNAM,TRUNC(OPT),OBJECT,NOLIST'
//SYSLIB   DD DSN=HERC01.LIFECORE.COPYLIB,DISP=SHR
//         DD DSN=CICSTS.V5R6M0.CICS.SDFHCOB,DISP=SHR
//SYSIN    DD DSN=&&DB2COB09,DISP=(OLD,DELETE)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT2   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT3   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT4   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT5   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT6   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT7   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSLIN   DD DSN=&&LCCOB09,DISP=(,PASS),
//            UNIT=SYSDA,SPACE=(CYL,(1,1))
//*
//LNK09    EXEC PGM=IEWL,COND=(0,NE,COB09),
//            PARM='REUS,LIST,MAP'
//SYSLIB   DD DSN=CICSTS.V5R6M0.CICS.SDFHLOAD,DISP=SHR
//         DD DSN=SYS1.LINKLIB,DISP=SHR
//SYSLMOD  DD DSN=HERC01.LIFECORE.CICS.LOAD(LCCICS09),DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DSN=&&LCCOB09,DISP=(OLD,DELETE)
//         DD *
  INCLUDE SYSLIB(DFHECI)
/*
