//LCDIA01  JOB (LIFECORE),'CICLO DIARIO',CLASS=A,MSGCLASS=X,
//         NOTIFY=&SYSUID,MSGLEVEL=(1,1),REGION=0M
//*
//* ================================================================
//* JOB    : LCDIA01
//* DESCRICAO: Ciclo Batch Diario do LifeCore-Mainframe
//*
//*   STEP010 - LIMPEZA       IEFBR14 - scratch datasets temporarios
//*   STEP020 - SORT APOLICE  DFSORT  - ordena por CNPJ+NUMERO
//*   STEP030 - VALIDA        ARQVAL01 - valida e quarentena
//*   STEP040 - CAPITAL       VGCCAP01 - calcula capital
//*   STEP050 - FATURA        FATURA01 - gera faturas (DB2)
//*   STEP060 - SORT PAGTO    DFSORT  - ordena pagamentos
//*   STEP070 - BAIXA         PAGTO01  - baixa pagamentos (DB2)
//*   STEP080 - CONCILIA      CONCIL01 - conciliacao fatura x pagto
//*   STEP090 - COMISSOES     COMIS01  - calculo de comissoes
//*   STEP100 - CLEARING      CLEAR01  - processa clearing bandeira
//*   STEP110 - LIQUIDACAO    SETTLE01 - concilia com agenda
//*   STEP120 - DISPUTAS      DISPUT01 - chargebacks e divergencias
//*   STEP130 - ICETOOL       RELATORIO resumo do dia
//*
//* CONVENCAO DE RETURN CODE:
//*   RC  0 = Sucesso total
//*   RC  4 = Avisos (divergencias, sem impacto critico)
//*   RC  8 = Erros de negocio (registros invalidos, etc.)
//*   RC 12 = Erro critico de I/O ou DB2
//*   RC 16 = Abend ou erro fatal
//*
//* AJUSTES ANTES DE SUBMETER:
//*   - Substituir DB2P pelo subsistema DB2 do ambiente
//*   - Ajustar HLQ LIFECORE para o ambiente alvo
//*   - Atualizar LOADLIB, DBRMLIB e nomes de plano (BIND)
//* ================================================================
//*
//* ---------------------------------------------------------------
//STEP010  EXEC PGM=IEFBR14
//* LIMPA DATASETS TEMPORARIOS DO DIA ANTERIOR
//APOLSORT DD  DSN=LIFECORE.DATA.TEMP.APOLSORT,
//             DISP=(MOD,DELETE,DELETE),
//             SPACE=(CYL,(5,1)),UNIT=SYSDA
//PAGSORT  DD  DSN=LIFECORE.DATA.TEMP.PAGSORT,
//             DISP=(MOD,DELETE,DELETE),
//             SPACE=(CYL,(5,1)),UNIT=SYSDA
//*
//* ---------------------------------------------------------------
//STEP020  EXEC PGM=SORT,COND=(8,LT,STEP010)
//* SORT DO ARQUIVO DE APOLICES: CNPJ ESTIPULANTE + NUMERO APOLICE
//SYSOUT   DD  SYSOUT=*
//SORTIN   DD  DSN=LIFECORE.DATA.GDG.APOLICE(0),DISP=SHR
//SORTOUT  DD  DSN=LIFECORE.DATA.TEMP.APOLSORT,
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,2)),UNIT=SYSDA,
//             RECFM=FB,LRECL=300,BLKSIZE=0
//SYSIN    DD  *
  SORT FIELDS=(3,14,CH,A,15,12,CH,A)
/*
//*
//* ---------------------------------------------------------------
//STEP030  EXEC PGM=ARQVAL01,COND=(8,LT)
//* VALIDACAO DO ARQUIVO DE APOLICES → QUARENTENA
//STEPLIB  DD  DSN=LIFECORE.LOAD,DISP=SHR
//SYSOUT   DD  SYSOUT=*
//LIFECORE.DATA.INPUT.APOLICE   DD DSN=LIFECORE.DATA.TEMP.APOLSORT,DISP=SHR
//LIFECORE.DATA.OUTPUT.APOLICE  DD DSN=LIFECORE.DATA.GDG.APOLICE(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,2)),UNIT=SYSDA,
//             RECFM=FB,LRECL=300,BLKSIZE=0
//LIFECORE.DATA.QUARANTINE.APOLICE DD DSN=LIFECORE.DATA.GDG.QUARENTENA(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(2,1)),UNIT=SYSDA,
//             RECFM=FB,LRECL=180,BLKSIZE=0
//*
//* ---------------------------------------------------------------
//STEP040  EXEC PGM=VGCCAP01,COND=(8,LT)
//* CALCULO DE CAPITAL SEGURADO
//STEPLIB  DD  DSN=LIFECORE.LOAD,DISP=SHR
//SYSOUT   DD  SYSOUT=*
//LIFECORE.DATA.OUTPUT.APOLICE  DD DSN=LIFECORE.DATA.GDG.APOLICE(0),DISP=SHR
//LIFECORE.DATA.OUTPUT.CAPITAL  DD DSN=LIFECORE.DATA.TEMP.CAPITAL,
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,2)),UNIT=SYSDA,
//             RECFM=FB,LRECL=300,BLKSIZE=0
//*
//* ---------------------------------------------------------------
//STEP050  EXEC PGM=IKJEFT01,COND=(8,LT)
//* FATURA01: GERACAO DE FATURAMENTO COM DB2 (via DSN command)
//STEPLIB  DD  DSN=LIFECORE.LOAD,DISP=SHR
//         DD  DSN=DSN.V13.SDSNLOAD,DISP=SHR
//SYSOUT   DD  SYSOUT=*
//SYSPRINT DD  SYSOUT=*
//SYSTSPRT DD  SYSOUT=*
//SYSTSIN  DD  *
  DSN SYSTEM(DB2P)
  RUN  PROGRAM(FATURA01) PLAN(LCFATPL) -
       LIB('LIFECORE.DBRMLIB')
  END
/*
//LIFECORE.DATA.OUTPUT.APOLICE  DD DSN=LIFECORE.DATA.TEMP.CAPITAL,DISP=SHR
//LIFECORE.DATA.OUTPUT.FATURA   DD DSN=LIFECORE.DATA.GDG.FATURA(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(5,1)),UNIT=SYSDA,
//             RECFM=FB,LRECL=250,BLKSIZE=0
//*
//* ---------------------------------------------------------------
//STEP060  EXEC PGM=SORT,COND=(8,LT)
//* SORT DO ARQUIVO DE PAGAMENTOS: NUMERO FATURA
//SYSOUT   DD  SYSOUT=*
//SORTIN   DD  DSN=LIFECORE.DATA.GDG.PAGAMENTO(0),DISP=SHR
//SORTOUT  DD  DSN=LIFECORE.DATA.TEMP.PAGSORT,
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(5,1)),UNIT=SYSDA,
//             RECFM=FB,LRECL=200,BLKSIZE=0
//SYSIN    DD  *
  SORT FIELDS=(19,14,CH,A)
/*
//*
//* ---------------------------------------------------------------
//STEP070  EXEC PGM=IKJEFT01,COND=(8,LT)
//* PAGTO01: BAIXA DE PAGAMENTOS COM DB2
//STEPLIB  DD  DSN=LIFECORE.LOAD,DISP=SHR
//         DD  DSN=DSN.V13.SDSNLOAD,DISP=SHR
//SYSOUT   DD  SYSOUT=*
//SYSPRINT DD  SYSOUT=*
//SYSTSPRT DD  SYSOUT=*
//SYSTSIN  DD  *
  DSN SYSTEM(DB2P)
  RUN  PROGRAM(PAGTO01) PLAN(LCPAGPL) -
       LIB('LIFECORE.DBRMLIB')
  END
/*
//LIFECORE.DATA.INPUT.PAGAMENTO  DD DSN=LIFECORE.DATA.TEMP.PAGSORT,DISP=SHR
//LIFECORE.DATA.OUTPUT.PAGAMENTO DD DSN=LIFECORE.DATA.GDG.PAGAMENTO(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(5,1)),UNIT=SYSDA,
//             RECFM=FB,LRECL=200,BLKSIZE=0
//*
//* ---------------------------------------------------------------
//STEP080  EXEC PGM=IKJEFT01,COND=(8,LT)
//* CONCIL01: CONCILIACAO FATURA x PAGAMENTO COM DB2
//STEPLIB  DD  DSN=LIFECORE.LOAD,DISP=SHR
//         DD  DSN=DSN.V13.SDSNLOAD,DISP=SHR
//SYSOUT   DD  SYSOUT=*
//SYSPRINT DD  SYSOUT=*
//SYSTSPRT DD  SYSOUT=*
//SYSTSIN  DD  *
  DSN SYSTEM(DB2P)
  RUN  PROGRAM(CONCIL01) PLAN(LCCONPL) -
       LIB('LIFECORE.DBRMLIB')
  END
/*
//LIFECORE.DATA.OUTPUT.FATURA      DD DSN=LIFECORE.DATA.GDG.FATURA(0),
//             DISP=SHR
//LIFECORE.DATA.OUTPUT.PAGAMENTO   DD DSN=LIFECORE.DATA.GDG.PAGAMENTO(0),
//             DISP=SHR
//LIFECORE.DATA.OUTPUT.CONCILIACAO DD DSN=LIFECORE.DATA.GDG.CONCILIACAO(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(5,1)),UNIT=SYSDA,
//             RECFM=FB,LRECL=220,BLKSIZE=0
//*
//* ---------------------------------------------------------------
//STEP090  EXEC PGM=COMIS01,COND=(8,LT)
//* COMIS01: CALCULO DE COMISSOES
//STEPLIB  DD  DSN=LIFECORE.LOAD,DISP=SHR
//SYSOUT   DD  SYSOUT=*
//LIFECORE.DATA.OUTPUT.CONCILIACAO DD DSN=LIFECORE.DATA.GDG.CONCILIACAO(0),
//             DISP=SHR
//LIFECORE.DATA.OUTPUT.COMISSAO    DD DSN=LIFECORE.DATA.GDG.COMISSAO(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(2,1)),UNIT=SYSDA,
//             RECFM=FB,LRECL=200,BLKSIZE=0
//*
//* ---------------------------------------------------------------
//STEP100  EXEC PGM=CLEAR01,COND=(8,LT)
//* CLEAR01: PROCESSA ARQUIVO DE CLEARING DA BANDEIRA
//STEPLIB  DD  DSN=LIFECORE.LOAD,DISP=SHR
//SYSOUT   DD  SYSOUT=*
//LIFECORE.DATA.INPUT.CLEARING  DD DSN=LIFECORE.DATA.GDG.CLEARING(0),
//             DISP=SHR
//LIFECORE.DATA.OUTPUT.CLEARING DD DSN=LIFECORE.DATA.TEMP.CLEARING,
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(5,1)),UNIT=SYSDA,
//             RECFM=FB,LRECL=300,BLKSIZE=0
//*
//* ---------------------------------------------------------------
//STEP110  EXEC PGM=SETTLE01,COND=(4,LT,STEP100)
//* SETTLE01: LIQUIDACAO - CLEARING x AGENDA DE RECEBIVEIS
//STEPLIB  DD  DSN=LIFECORE.LOAD,DISP=SHR
//SYSOUT   DD  SYSOUT=*
//LIFECORE.DATA.OUTPUT.CLEARING DD DSN=LIFECORE.DATA.TEMP.CLEARING,DISP=SHR
//LIFECORE.DATA.INPUT.AGENDA    DD DSN=LIFECORE.DATA.GDG.AGENDA(0),DISP=SHR
//LIFECORE.DATA.OUTPUT.LIQUIDACAO DD DSN=LIFECORE.DATA.TEMP.LIQUIDACAO,
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(5,1)),UNIT=SYSDA,
//             RECFM=FB,LRECL=300,BLKSIZE=0
//*
//* ---------------------------------------------------------------
//STEP120  EXEC PGM=IKJEFT01,COND=(0,EQ,STEP110)
//* DISPUT01: CHARGEBACKS E DISPUTAS COM DB2
//STEPLIB  DD  DSN=LIFECORE.LOAD,DISP=SHR
//         DD  DSN=DSN.V13.SDSNLOAD,DISP=SHR
//SYSOUT   DD  SYSOUT=*
//SYSPRINT DD  SYSOUT=*
//SYSTSPRT DD  SYSOUT=*
//SYSTSIN  DD  *
  DSN SYSTEM(DB2P)
  RUN  PROGRAM(DISPUT01) PLAN(LCDISPL) -
       LIB('LIFECORE.DBRMLIB')
  END
/*
//LIFECORE.DATA.OUTPUT.LIQUIDACAO DD DSN=LIFECORE.DATA.TEMP.LIQUIDACAO,
//             DISP=SHR
//LIFECORE.DATA.OUTPUT.DISPUTAS   DD DSN=LIFECORE.DATA.TEMP.DISPUTAS,
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(2,1)),UNIT=SYSDA,
//             RECFM=FB,LRECL=300,BLKSIZE=0
//*
//* ---------------------------------------------------------------
//STEP130  EXEC PGM=ICETOOL,COND=(12,LT)
//* ICETOOL: RELATORIO DE TOTALIZACAO DO DIA
//TOOLMSG  DD  SYSOUT=*
//DFSMSG   DD  SYSOUT=*
//SYSOUT   DD  SYSOUT=*
//APOLICE  DD  DSN=LIFECORE.DATA.GDG.APOLICE(0),DISP=SHR
//FATURA   DD  DSN=LIFECORE.DATA.GDG.FATURA(0),DISP=SHR
//PAGTO    DD  DSN=LIFECORE.DATA.GDG.PAGAMENTO(0),DISP=SHR
//CONCIL   DD  DSN=LIFECORE.DATA.GDG.CONCILIACAO(0),DISP=SHR
//TOOLIN   DD  *
  COUNT FROM(APOLICE) TITLE('APOLICES VALIDAS')
  COUNT FROM(FATURA)  TITLE('FATURAS GERADAS')
  COUNT FROM(PAGTO)   TITLE('PAGAMENTOS PROCESSADOS')
  COUNT FROM(CONCIL)  TITLE('REGISTROS CONCILIADOS')
/*
