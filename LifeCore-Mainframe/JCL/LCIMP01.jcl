//LCIMP01  JOB (LIFECORE),'IMPORTACAO API',CLASS=A,MSGCLASS=X,
//         NOTIFY=&SYSUID,MSGLEVEL=(1,1),REGION=0M
//*
//* ================================================================
//* JOB    : LCIMP01
//* DESCRICAO: Ciclo de importacao disparado pela Integration Layer
//*            Executado quando a API faz upload via Zowe CLI.
//*
//*   Diferenca em relacao ao LCDIA01:
//*   - Arquivo de entrada ja esta em LIFECORE.DATA.INPUT.APOLICE
//*     (enviado pela API via Zowe files ul ftds)
//*   - Nao executa o passo de SORT (arquivo ja vem ordenado pela API)
//*   - Nao executa CLEAR01/SETTLE01/DISPUT01 (clearing e assíncrono)
//*
//*   STEPS:
//*   STEP010 - ARQVAL01  Valida arquivo e separa quarentena
//*   STEP020 - VGCCAP01  Calcula capital segurado
//*   STEP030 - FATURA01  Gera faturas (DB2)
//*   STEP040 - CONCIL01  Conciliacao inicial (DB2)
//*   STEP050 - ICETOOL   Relatorio de totais
//* ================================================================
//*
//STEP010  EXEC PGM=ARQVAL01
//STEPLIB  DD  DSN=LIFECORE.LOAD,DISP=SHR
//SYSOUT   DD  SYSOUT=*
//LIFECORE.DATA.INPUT.APOLICE      DD DSN=LIFECORE.DATA.INPUT.APOLICE,
//             DISP=SHR
//LIFECORE.DATA.OUTPUT.APOLICE     DD DSN=LIFECORE.DATA.GDG.APOLICE(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,2)),UNIT=SYSDA,
//             RECFM=FB,LRECL=300,BLKSIZE=0
//LIFECORE.DATA.QUARANTINE.APOLICE DD DSN=LIFECORE.DATA.GDG.QUARENTENA(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(2,1)),UNIT=SYSDA,
//             RECFM=FB,LRECL=180,BLKSIZE=0
//*
//STEP020  EXEC PGM=VGCCAP01,COND=(8,LT,STEP010)
//STEPLIB  DD  DSN=LIFECORE.LOAD,DISP=SHR
//SYSOUT   DD  SYSOUT=*
//LIFECORE.DATA.OUTPUT.APOLICE  DD DSN=LIFECORE.DATA.GDG.APOLICE(0),DISP=SHR
//LIFECORE.DATA.OUTPUT.CAPITAL  DD DSN=LIFECORE.DATA.TEMP.CAPITAL,
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,2)),UNIT=SYSDA,
//             RECFM=FB,LRECL=300,BLKSIZE=0
//*
//STEP030  EXEC PGM=IKJEFT01,COND=(8,LT)
//STEPLIB  DD  DSN=LIFECORE.LOAD,DISP=SHR
//         DD  DSN=DSN.V13.SDSNLOAD,DISP=SHR
//SYSOUT   DD  SYSOUT=*
//SYSPRINT DD  SYSOUT=*
//SYSTSPRT DD  SYSOUT=*
//SYSTSIN  DD  *
  DSN SYSTEM(DB2P)
  RUN  PROGRAM(FATURA01) PLAN(LCFATPL) LIB('LIFECORE.DBRMLIB')
  END
/*
//LIFECORE.DATA.OUTPUT.APOLICE  DD DSN=LIFECORE.DATA.TEMP.CAPITAL,DISP=SHR
//LIFECORE.DATA.OUTPUT.FATURA   DD DSN=LIFECORE.DATA.GDG.FATURA(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(5,1)),UNIT=SYSDA,
//             RECFM=FB,LRECL=250,BLKSIZE=0
//*
//STEP040  EXEC PGM=IKJEFT01,COND=(8,LT)
//STEPLIB  DD  DSN=LIFECORE.LOAD,DISP=SHR
//         DD  DSN=DSN.V13.SDSNLOAD,DISP=SHR
//SYSOUT   DD  SYSOUT=*
//SYSPRINT DD  SYSOUT=*
//SYSTSPRT DD  SYSOUT=*
//SYSTSIN  DD  *
  DSN SYSTEM(DB2P)
  RUN  PROGRAM(CONCIL01) PLAN(LCCONPL) LIB('LIFECORE.DBRMLIB')
  END
/*
//LIFECORE.DATA.OUTPUT.FATURA      DD DSN=LIFECORE.DATA.GDG.FATURA(0),
//             DISP=SHR
//LIFECORE.DATA.OUTPUT.PAGAMENTO   DD DUMMY
//LIFECORE.DATA.OUTPUT.CONCILIACAO DD DSN=LIFECORE.DATA.GDG.CONCILIACAO(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(5,1)),UNIT=SYSDA,
//             RECFM=FB,LRECL=220,BLKSIZE=0
//*
//STEP050  EXEC PGM=ICETOOL,COND=(12,LT)
//TOOLMSG  DD  SYSOUT=*
//DFSMSG   DD  SYSOUT=*
//APOLICE  DD  DSN=LIFECORE.DATA.GDG.APOLICE(0),DISP=SHR
//FATURA   DD  DSN=LIFECORE.DATA.GDG.FATURA(0),DISP=SHR
//QUARENT  DD  DSN=LIFECORE.DATA.GDG.QUARENTENA(0),DISP=SHR
//TOOLIN   DD  *
  COUNT FROM(APOLICE)  TITLE('APOLICES VALIDAS  - IMPORTACAO API')
  COUNT FROM(FATURA)   TITLE('FATURAS GERADAS   - IMPORTACAO API')
  COUNT FROM(QUARENT)  TITLE('REGISTROS QUARENTENA')
/*
