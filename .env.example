# =============================================================
# .env.example — LifeCore IQ (raiz do repositório)
# Copie para .env e ajuste para o seu ambiente local.
# NUNCA commite o arquivo .env com credenciais reais.
# =============================================================

# ── Integration Layer ─────────────────────────────────────────
# Banco de dados PostgreSQL
DATABASE_URL=postgresql://lifecore:senha@localhost:5432/lifecore_iq

# Autenticação JWT — gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=troque-esta-chave-em-producao
AUTH_ACCESS_EXPIRE_MIN=30
AUTH_REFRESH_EXPIRE_H=168

# DB2 z/OS é a fonte única dos cadastros compartilhados com CICS.
# Configure uma string DRDA sem gravar credenciais no repositório.
DB2_DSN=
DB2_SCHEMA=LIFECORE

# Conector batch: stub | local | zowe
BATCH_CONNECTOR=stub

# ── Zowe CLI (somente se BATCH_CONNECTOR=zowe) ────────────────
ZOWE_PROFILE=zos-dev
ZOS_HLQ=LIFECORE
ZOS_DB2_SYSTEM=DB2P

# ── OpenTelemetry ─────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_SERVICE_NAME=lifecore-integration-layer
ENVIRONMENT=development

# ── Receita Federal (Motor de Críticas) ───────────────────────
# false = desabilitado (recomendado para dev/testes)
RECEITA_WS_ENABLED=false

# ── Diretórios de dados (batch local) ─────────────────────────
DATA_INPUT_DIR=/tmp/lifecore/DATA/INPUT
DATA_OUTPUT_DIR=/tmp/lifecore/DATA/OUTPUT
DATA_QUARANTINE_DIR=/tmp/lifecore/DATA/QUARANTINE

# ── Notion Integration ────────────────────────────────────────
# Obtenha em: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_COLOQUE_SEU_TOKEN_AQUI
NOTION_DATABASE_ID=COLOQUE_O_ID_DO_DATABASE_AQUI
NOTION_STUDY_PAGE_ID=COLOQUE_O_ID_DA_PAGINA_AQUI
